{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window may access validated household repositories and copy its grocery list.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-storage-status",
    "allow-get-catalog",
    "allow-create-ingredient",
    "allow-update-ingredient",
    "allow-retire-ingredient",
    "allow-list-meals",
    "allow-get-meal",
    "allow-create-meal",
    "allow-update-meal",
    "allow-retire-meal",
    "allow-list-fields",
    "allow-create-field",
    "allow-update-field",
    "allow-retire-field",
    "allow-create-vocabulary",
    "allow-update-vocabulary",
    "allow-retire-vocabulary",
    "allow-get-measurement-preferences",
    "allow-save-measurement-preferences",
    "allow-convert-measurement",
    "allow-list-conversion-rules",
    "allow-save-conversion-rule",
    "allow-retire-conversion-rule",
    "allow-ingredient-candidates",
    "allow-search-ingredients",
    "allow-search-meals",
    "allow-save-meal-draft",
    "allow-get-week",
    "allow-apply-plan",
    "allow-get-meal-history",
    "allow-change-meal-history",
    "allow-get-shopping",
    "allow-change-shopping",
    "allow-copy-shopping",
    "allow-inspect-recipe-url",
    "allow-preview-recipe-import",
    "allow-confirm-recipe-import",
    "allow-open-recipe-browser",
    "allow-reset-recipe-browser",
    "allow-capture-recipe-browser",
    "allow-get-backup-info",
    "allow-export-backup",
    "allow-preview-restore",
    "allow-restore-backup",
    "allow-get-usability-preferences",
    "allow-save-usability-preferences",
    "allow-read-recipe-clipboard-url",
    "allow-check-app-update",
    "allow-install-app-update"
  ]
}
